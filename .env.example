OPENAI_API_KEY=
DEBUG=false

APP_NAME=career-pilot-ai
SERVER_PORT=8080

OPENAI_TEMPERATURE=0
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_MODEL_RESUME_ANALYSIS=gpt-5-nano
OPENAI_MODEL_JOB_MATCHING=gpt-5-mini
OPENAI_MODEL_SKILL_GAP=gpt-5-mini
OPENAI_MODEL_STUDY_PLANNING=gpt-5-mini
OPENAI_MODEL_EVALUATOR=gpt-4o-mini

# Study plan RAG (learning_resources.jsonl)
STUDY_PLAN_RAG_TOP_K=5
INTERNAL_COMPANY_NAME=CareerPilot
JOB_WEB_SEARCH_ENABLED=true
JOB_WEB_SEARCH_MAX_RESULTS=5
STUDY_PLAN_WEB_SEARCH_ENABLED=true
# Optional: absolute path to learning_resources.jsonl. Leave unset to use packaged data/.
# Do NOT set to empty (LEARNING_RESOURCES_PATH=) — that disables loading.
# LEARNING_RESOURCES_PATH=

# Auth (JWT accounts — long-term memory binds to account user_id when logged in)
AUTH_ENABLED=true
AUTH_REQUIRED=false
AUTH_JWT_SECRET=change-me-in-production
AUTH_JWT_EXPIRE_HOURS=168
# AUTH_ACCOUNTS_PATH=data/accounts.json

# MySQL — local: docker compose up -d mysql, then use URL below.
# Leave unset to keep JSON files for accounts + user_memory (dev without DB).
DATABASE_URL=mysql+pymysql://cbc:CareerPilot2.0@/careerpilot?unix_socket=/cloudsql/careerpilot-ai-493209:asia-southeast1:careerpilot
DATABASE_AUTO_CREATE_TABLES=true

# Observability
LOG_LEVEL=INFO
LOG_JSON=false
METRICS_ENDPOINT_ENABLED=true

# LangSmith tracing (see .agents/skills/langsmith-trace/SKILL.md)
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=careerpilot-ai
# LANGSMITH_WORKSPACE_ID=
# Cloud Run / serverless: keep false so traces flush before the handler exits
LANGCHAIN_CALLBACKS_BACKGROUND=false

# Legacy aliases (still supported)
# LANGCHAIN_TRACING_V2=true
# LANGCHAIN_API_KEY=
# LANGCHAIN_PROJECT=careerpilot-ai
